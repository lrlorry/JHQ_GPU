         CUDA_CHECK(cudaDeviceSynchronize());
 
         int* d_assign_batch = assign_on_gpu(d_y_batch, nb);
@@ -742,6 +753,7 @@ void JHQGpuIndex::search(const float* h_q, int nq, int k,
                h_q,
                nq, d_, M_, Ds_, K_, Kr_, nlist_, nprobe_,
                Br_, bpv_,
