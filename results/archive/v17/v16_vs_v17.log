# v17 (two-stage scan) vs v16, Vogue-768, M=96 B=8 Br=4 nlist=1024 batch=256, km=5
# RTX 5090, 2026-09-02. Recall is standard Recall@10 (common/recall.cuh).
#
# v17 splits the scan over (query, probe): grid goes from B=256 blocks to
# B*nprobe, and a second kernel merges the per-list partials into top-ck.

## same parameters
v16  np=1     Recall@10 0.4454   QPS 20239
v17  np=1     Recall@10 0.4454   QPS 25981     (+28%)
v16  np=8     Recall@10 0.7327   QPS 16843
v17  np=8     Recall@10 0.7284   QPS 20439     (+21%, recall -0.0043)
v16  np=128   Recall@10 0.8974   QPS 11016
v17  np=128   Recall@10 0.8938   QPS 14646     (+33%, recall -0.0036)

## matched-recall operating point
v16  a=100 np=128   Recall@10 0.9448   QPS 10502
v17  a=100 np=128   Recall@10 0.9209   QPS 13844   (+32%, recall -0.0239)

## reference, same data and same Recall@10 definition
cuVS IVF-PQ 384B  np=128   Recall@10 0.9441   QPS 20907   (52% of peak bandwidth)
