+#!/bin/bash
+# Process-level comparison of several binaries in alternating order (forward, then reversed,
+# repeated), batch workload: separates a difference between builds from machine drift.
+#   bash ab3_box.sh <out dir> <repeats> name=binary [name=binary ...]
+# Binaries built with refine_grouping run modes 0 and -1; the reference runs as it is.
+set -u
+OUT=$1; REP=$2; shift 2
+LGR=/root/autodl-tmp/lgr
+D=/root/data
+BASE=$D/vogue-768_base.fvecs; QUERY=$D/vogue-768_query.fvecs; GT=$D/vogue-768_groundtruth.ivecs
+IDX=$LGR/index/vogue_nl1024_m96
+mkdir -p $OUT
+export OPENBLAS_NUM_THREADS=1 OMP_WAIT_POLICY=PASSIVE JHQ_BENCH_ROUNDS=3 JHQ_BENCH_WORKLOADS=batch
+export JHQ_BENCH_GRID=10:2,10:10,10:100,100:20 JHQ_BENCH_NPROBE=32 JHQ_BENCH_MODES=0,-1
+fwd=("$@"); rev=(); for ((i=${#fwd[@]}-1; i>=0; i--)); do rev+=("${fwd[i]}"); done
+echo "=== $(date -u +%FT%TZ) $*"
+for st in predecoded packed; do
+  n=0
+  for r in $(seq $REP); do
+    for nb in "${fwd[@]}" "${rev[@]}"; do
+      n=$((n+1)); name=${nb%%=*}; bin=${nb#*=}
+      timeout 3600 $bin run $st $IDX $BASE $QUERY $GT $OUT/${st}_${n}_$name.json > $OUT/${st}_${n}_$name.log 2>&1
+      echo "$st #$n $name rc=$? $(tail -1 $OUT/${st}_${n}_$name.log)  $(date -u +%T)"
+    done
+  done
+done
+echo "=== AB3_DONE $(date -u +%FT%TZ)"
