+#!/bin/bash
+# Process-level A/B of the reference binary and an optimised one, in alternating processes
+# (ABBA, repeated), to tell a difference between the binaries from the drift of a shared machine.
+# The optimised binary runs modes 0 and -1 (the original loop, kept in it, and the automatic choice)
+# in-process; the reference runs the library as it was.
+#
+#   bash ab_box.sh <out dir> <optimised binary> [repeats (2)]
+set -u
+OUT=$1; OPT=$2; REP=${3:-2}
+LGR=/root/autodl-tmp/lgr
+D=/root/data
+BASE=$D/vogue-768_base.fvecs; QUERY=$D/vogue-768_query.fvecs; GT=$D/vogue-768_groundtruth.ivecs
+REF=$LGR/build_ref/examples/bench_refine_locality
+IDX=$LGR/index/vogue_nl1024_m96
+mkdir -p $OUT
+export OPENBLAS_NUM_THREADS=1 OMP_WAIT_POLICY=PASSIVE JHQ_BENCH_SINGLE_NQ=100 JHQ_BENCH_ROUNDS=3
+export JHQ_BENCH_GRID=10:2,10:10,10:100,100:20 JHQ_BENCH_NPROBE=32
+echo "=== $(date -u +%FT%TZ) A/B ref=$REF opt=$OPT repeats=$REP"
+for st in predecoded packed; do
+  n=0
+  for r in $(seq $REP); do
+    for b in ref opt opt ref; do
+      n=$((n+1))
+      if [ $b = ref ]; then bin=$REF; modes=""; else bin=$OPT; modes="0,-1"; fi
+      env JHQ_BENCH_MODES=$modes timeout 3600 $bin run $st $IDX $BASE $QUERY $GT $OUT/${st}_${n}_$b.json \
+          > $OUT/${st}_${n}_$b.log 2>&1
+      echo "$st #$n $b rc=$? $(tail -1 $OUT/${st}_${n}_$b.log)  $(date -u +%T)"
+    done
+  done
+done
+echo "=== AB_DONE $(date -u +%FT%TZ)"
