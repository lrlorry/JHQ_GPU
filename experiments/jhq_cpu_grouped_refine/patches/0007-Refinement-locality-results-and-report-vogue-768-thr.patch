+#!/bin/bash
+# (kept for the record: the last check of the shipped build, launched from the scratch copy)
+# final commit, built as shipped (no profiling, default flags of the earlier box build): compile and a correctness smoke
+set -u
+LGR=/root/autodl-tmp/lgr; SRC=/root/autodl-tmp/JHQ_lgr; W=/root/autodl-tmp/JHQ_lgr_final
+export PATH=/usr/local/bin:/usr/bin:/bin:$PATH OPENBLAS_NUM_THREADS=1
+[ -d $W ] || git -C $SRC worktree add -q --detach $W 9bd9990
+git -C $W checkout -q --detach 9bd9990
+[ -e $W/jhq/external/faiss ] || ln -s $SRC/jhq/external/faiss $W/jhq/external/faiss
+echo "=== $(date -u +%FT%TZ) $(git -C $W log --oneline -1) tree $(git -C $W rev-parse HEAD^{tree})"
+timeout 900 cmake -S $W/jhq -B $LGR/build_final -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++-12 \
+  -DCMAKE_CXX_FLAGS="-mavx2 -mno-avx512f -mno-avx512vl -mno-avx512bw -mno-avx512dq -include immintrin.h" \
+  -DENABLE_CLANG_TIDY=OFF -DENABLE_CLANG_FORMAT=OFF -DENABLE_CMAKE_FORMAT=OFF -DENABLE_TESTING=OFF > $LGR/build_final.cmake.log 2>&1
+echo "cmake_rc=$?"
+timeout 3600 cmake --build $LGR/build_final -j 20 --target bench_refine_locality > $LGR/build_final.build.log 2>&1
+rc=$?; echo "build_rc=$rc"
+[ $rc -ne 0 ] && { grep -E "error" $LGR/build_final.build.log | head; echo "=== BUILD_FAILED"; exit 1; }
