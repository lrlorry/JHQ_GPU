@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+"""Summary of ab_box.sh: the reference binary against the optimised one, process by process.
+
+    python3 analyze_ab.py <ab dir> [--md out.md]
+
+Files <storage>_<n>_<ref|opt>.json, in ABBA order (ref opt opt ref, repeated). For every
+configuration (workload, k, alpha, nprobe):
+  * every hash, of every process and mode, must be one value (identical results);
+  * each process is reduced to its median over rounds (batch QPS, single mean latency), for the
+    optimised binary separately for mode 0 (the original loop it keeps) and -1 (automatic);
+  * the optimised processes are compared with the reference processes of the same ABBA block,
+    then the median and range over blocks are reported, as speedups (> 1 = optimised faster).
+"""
+import glob
+import json
+import os
+import re
+import statistics
+import sys
+from collections import defaultdict
+
+
+def main():
+    d = sys.argv[1]
+    md = sys.argv[sys.argv.index("--md") + 1] if "--md" in sys.argv else None
+    lines = []
+
+    def emit(s=""):
+        print(s)
+        lines.append(s)
+
+    for st in ("predecoded", "packed", "separated"):
+        files = sorted(glob.glob(os.path.join(d, f"{st}_*_*.json")),
+                       key=lambda p: int(re.search(rf"{st}_(\d+)_", p).group(1)))
+        if not files:
+            continue
+        procs = []  # (n, kind, {key: {mode: value}}, {key: set(hash)})
+        for p in files:
+            n, kind = re.search(rf"{st}_(\d+)_(ref|opt)\.json$", p).groups()
+            j = json.load(open(p))
+            vals = defaultdict(lambda: defaultdict(list))
+            hashes = defaultdict(set)
+            for r in j["runs"]:
+                key = (r["workload"], r["k"], r["alpha"], r["nprobe"])
+                vals[key][r["mode"]].append(r["qps"] if r["workload"] == "batch" else r["lat_mean_us"])
+                hashes[key].add(r["hash"])
+            procs.append((int(n), kind, {k: {m: statistics.median(v) for m, v in mv.items()} for k, mv in vals.items()},
+                          hashes))
+        keys = sorted(procs[0][2].keys())
+        bad = [k for k in keys if len(set().union(*[p[3][k] for p in procs])) != 1]
+        emit(f"\n## {st}: {len(procs)} processes, {len(keys)} configurations; configurations whose results differ "
+             f"between any processes or modes: {len(bad)}")
+        emit("\n| workload | k | alpha | nprobe | ref | opt mode 0 | opt auto | mode 0 / ref | auto / ref | auto / mode 0 |")
+        emit("|---|---:|---:|---:|---:|---:|---:|---|---|---|")
+        blocks = [procs[i:i + 4] for i in range(0, len(procs), 4)]
+        for key in keys:
+            batch = key[0] == "batch"
+            sp0, spa, spi = [], [], []
+            refv, m0v, av = [], [], []
+            for b in blocks:
+                refs = [p[2][key]["ref"] for p in b if p[1] == "ref"]
+                opts = [p[2][key] for p in b if p[1] == "opt"]
+                r = statistics.median(refs)
+                for o in opts:
+                    m0, au = o["0"], o["-1"]
+                    refv.append(r); m0v.append(m0); av.append(au)
+                    if batch:
+                        sp0.append(m0 / r); spa.append(au / r); spi.append(au / m0)
+                    else:
+                        sp0.append(r / m0); spa.append(r / au); spi.append(m0 / au)
+            f = lambda xs: f"{statistics.median(xs):.3f} [{min(xs):.3f}, {max(xs):.3f}]"
+            unit = "QPS" if batch else "us"
+            emit(f"| {key[0]} | {key[1]} | {key[2]:g} | {key[3]} | {statistics.median(refv):.0f} {unit} | "
+                 f"{statistics.median(m0v):.0f} | {statistics.median(av):.0f} | {f(sp0)} | {f(spa)} | {f(spi)} |")
+    if md:
+        open(md, "w").write("\n".join(lines) + "\n")
+
+
+if __name__ == "__main__":
+    main()
