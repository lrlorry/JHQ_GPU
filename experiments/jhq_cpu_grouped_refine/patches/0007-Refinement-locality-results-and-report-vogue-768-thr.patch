@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""Summary of ab3_box.sh: several binaries in alternating processes, against the reference.
+
+    python3 analyze_ab3.py <dir> <number of binaries> [--md out.md]
+
+Files <storage>_<n>_<name>.json, n counting through blocks of 2 x binaries (forward then reversed).
+Per configuration: each process reduced to its median over rounds (batch QPS) per mode; within each
+block, every other binary's processes divided by the median of the block's reference processes
+("ref"); median and range over the blocks' ratios (> 1 = faster than the reference). Results must
+be one hash per configuration across all processes and modes.
+"""
+import glob
+import json
+import os
+import re
+import statistics
+import sys
+from collections import defaultdict
+
+
+def main():
+    d, nb = sys.argv[1], int(sys.argv[2])
+    md = sys.argv[sys.argv.index("--md") + 1] if "--md" in sys.argv else None
+    lines = []
+
+    def emit(s=""):
+        print(s)
+        lines.append(s)
+
+    for st in ("predecoded", "packed"):
+        files = glob.glob(os.path.join(d, f"{st}_*_*.json"))
+        if not files:
+            continue
+        procs = []
+        for p in files:
+            n, name = re.search(rf"{st}_(\d+)_([a-z0-9]+)\.json$", p).groups()
+            j = json.load(open(p))
+            vals = defaultdict(lambda: defaultdict(list))
+            hashes = defaultdict(set)
+            for r in j["runs"]:
+                key = (r["workload"], r["k"], r["alpha"], r["nprobe"])
+                vals[key][r["mode"]].append(r["qps"])
+                hashes[key].add(r["hash"])
+            procs.append((int(n), name, {k: {m: statistics.median(v) for m, v in mv.items()} for k, mv in vals.items()},
+                          hashes))
+        procs.sort()
+        keys = sorted(procs[0][2])
+        bad = sum(1 for k in keys if len(set().union(*[p[3][k] for p in procs])) != 1)
+        names = sorted({p[1] for p in procs if p[1] != "ref"})
+        emit(f"\n## {st}: {len(procs)} processes; configurations with differing results: {bad}")
+        hdr = " | ".join(f"{nm} mode {m} / ref" for nm in names for m in ("0", "-1"))
+        emit(f"\n| k | alpha | nprobe | ref QPS | {hdr} |")
+        emit("|---:|---:|---:|---:|" + "---|" * (2 * len(names)))
+        bs = 2 * nb
+        for key in keys:
+            ratios = defaultdict(list)
+            refs_all = []
+            for b0 in range(0, len(procs), bs):
+                blk = procs[b0:b0 + bs]
+                rv = statistics.median([p[2][key]["ref"] for p in blk if p[1] == "ref"])
+                refs_all.append(rv)
+                for p in blk:
+                    if p[1] == "ref":
+                        continue
+                    for m in ("0", "-1"):
+                        ratios[(p[1], m)].append(p[2][key][m] / rv)
+            cells = " | ".join(
+                f"{statistics.median(ratios[(nm, m)]):.3f} [{min(ratios[(nm, m)]):.3f}, {max(ratios[(nm, m)]):.3f}]"
+                for nm in names for m in ("0", "-1"))
+            emit(f"| {key[1]} | {key[2]:g} | {key[3]} | {statistics.median(refs_all):.0f} | {cells} |")
+    if md:
+        open(md, "w").write("\n".join(lines) + "\n")
+
+
+if __name__ == "__main__":
+    main()
