 namespace faiss {
 
+namespace {
+
+using RefineClock = std::chrono::steady_clock;
+
+// The result heap update of the global two-stage refinement: a strict
+// comparison with the heap top, so that of two equal distances the one pushed
+// first stays. Every refinement mode pushes in primary order through this.
+inline void push_refined(bool is_max_heap,
+    size_t k,
+    float* simi,
+    idx_t* idxi,
+    float dis,
+    idx_t id)
+{
+    if (is_max_heap) {
+        if (CMin<float, idx_t>::cmp(simi[0], dis)) {
+            heap_replace_top<CMin<float, idx_t>>(k, simi, idxi, dis, id);
+        }
+    } else {
+        if (CMax<float, idx_t>::cmp(simi[0], dis)) {
+            heap_replace_top<CMax<float, idx_t>>(k, simi, idxi, dis, id);
+        }
+    }
+}
+
+struct RefineCounters {
+    size_t candidates = 0;
+    size_t groups = 0;
+    size_t set_list_calls = 0;
+    size_t scoped_acquisitions = 0;
+    size_t grouped_queries = 0;
+};
+
+// The original refinement: one candidate at a time in primary order, each
+// with its own set_list and scoped codes and ids.
+void refine_one_at_a_time(const IndexIVFJHQ& index,
+    InvertedListScanner* scanner,
+    const IVFJHQScanner* jhq_scanner,
+    const float* candidate_primary,
+    const idx_t* candidate_locs,
+    size_t candidate_count,
+    bool store_pairs,
+    bool is_max_heap,
+    size_t k,
+    float* simi,
+    idx_t* idxi,
+    RefineCounters& counters)
+{
+    for (size_t ci = 0; ci < candidate_count; ++ci) {
+        const idx_t loc = candidate_locs[ci];
+        const idx_t list_no = lo_listno(loc);
+        const idx_t offset = lo_offset(loc);
+        if (list_no < 0 || static_cast<size_t>(list_no) >= index.nlist) {
+            continue;
+        }
+
+        const size_t list_size = index.invlists->list_size(list_no);
+        if (offset < 0 || static_cast<size_t>(offset) >= list_size) {
+            continue;
+        }
+
+        scanner->set_list(list_no, 0.0f);
+        InvertedLists::ScopedCodes codes(index.invlists, list_no);
+        InvertedLists::ScopedIds ids(index.invlists, list_no);
+
+        const uint8_t* packed_code =
+            codes.get() + static_cast<size_t>(offset) * index.code_size;
+        const float dis = jhq_scanner->refine_distance_from_primary_for_list(
+            static_cast<size_t>(offset),
+            packed_code,
+            candidate_primary[ci]);
+        const idx_t id = store_pairs ? loc : ids.get()[offset];
+
+        push_refined(is_max_heap, k, simi, idxi, dis, id);
+        ++counters.candidates;
+        ++counters.set_list_calls;
+        ++counters.scoped_acquisitions;
+    }
+}
+
+// Scratch of the grouped refinement, one per thread, kept across queries and
+// searches so that a query allocates nothing once the buffers have grown.
+struct RefineScratch {
+    std::vector<idx_t> slot_list;       // open addressing, list_no -> group (-1 empty)
+    std::vector<int32_t> slot_group;
+    std::vector<idx_t> group_list;      // per group
+    std::vector<uint32_t> group_begin;  // per group, and the end
+    std::vector<uint32_t> group_fill;
+    std::vector<int32_t> cand_group;    // per candidate, -1 for an invalid list
+    std::vector<uint32_t> order;        // candidates, group by group
+    std::vector<float> dis;             // per candidate, its refined distance
+    std::vector<idx_t> ids;             // per candidate, its result id
+    std::vector<uint8_t> refined;       // per candidate, whether it was refined
+
+    size_t bytes() const
+    {
+        return slot_list.capacity() * sizeof(idx_t) + slot_group.capacity() * sizeof(int32_t) +
+            group_list.capacity() * sizeof(idx_t) +
+            (group_begin.capacity() + group_fill.capacity()) * sizeof(uint32_t) +
+            cand_group.capacity() * sizeof(int32_t) + order.capacity() * sizeof(uint32_t) +
+            dis.capacity() * sizeof(float) + ids.capacity() * sizeof(idx_t) +
+            refined.capacity() * sizeof(uint8_t);
+    }
+};
+
+thread_local RefineScratch refine_scratch;
+
+// List-grouped refinement. The candidates are grouped by list in O(T + lists)
+// (a counting sort over a small hash map, no sort of the T), each list is
+// opened once -- one set_list, one ScopedCodes and one ScopedIds -- and its
+// candidates refined together, optionally in ascending offset. Each refined
+// distance and id is kept at the candidate's own position, and the result heap
+// is then filled in primary order: the same calls, with the same values, in
+// the same order as refine_one_at_a_time makes.
+//
+// Returns false, having touched nothing, if the candidates come from more than
+// max_lists lists (not possible when they come from the query's probes); the
+// caller then refines one at a time.
+bool refine_grouped(const IndexIVFJHQ& index,
+    InvertedListScanner* scanner,
+    const IVFJHQScanner* jhq_scanner,
+    const float* candidate_primary,
+    const idx_t* candidate_locs,
+    size_t candidate_count,
+    size_t max_lists,
+    bool ascending_offsets,
+    bool store_pairs,
+    bool is_max_heap,
+    size_t k,
+    float* simi,
+    idx_t* idxi,
+    RefineCounters& counters,
+    size_t& scratch_bytes)
+{
+    RefineScratch& s = refine_scratch;
+    const size_t T = candidate_count;
+
+    size_t cap = 16;
+    int log2cap = 4;
+    while (cap < 2 * std::min(T, std::max<size_t>(max_lists, 1))) {
+        cap <<= 1;
+        ++log2cap;
+    }
+    const size_t mask = cap - 1;
+    s.slot_list.assign(cap, -1);
+    s.slot_group.resize(cap);
+    s.group_list.clear();
+    s.group_fill.clear();
+    s.cand_group.resize(T);
+
+    for (size_t ci = 0; ci < T; ++ci) {
+        const idx_t list_no = lo_listno(candidate_locs[ci]);
+        if (list_no < 0 || static_cast<size_t>(list_no) >= index.nlist) {
+            s.cand_group[ci] = -1;
+            continue;
+        }
+        size_t h = static_cast<size_t>(
+            (static_cast<uint64_t>(list_no) * 0x9E3779B97F4A7C15ull) >> (64 - log2cap));
+        while (s.slot_list[h] != -1 && s.slot_list[h] != list_no) {
+            h = (h + 1) & mask;
+        }
+        if (s.slot_list[h] == -1) {
+            if (2 * (s.group_list.size() + 1) > cap) {
+                return false;
+            }
+            s.slot_list[h] = list_no;
+            s.slot_group[h] = static_cast<int32_t>(s.group_list.size());
+            s.group_list.push_back(list_no);
+            s.group_fill.push_back(0);
+        }
+        const int32_t g = s.slot_group[h];
+        s.cand_group[ci] = g;
+        ++s.group_fill[g];
+    }
+
+    const size_t ngroups = s.group_list.size();
+    s.group_begin.resize(ngroups + 1);
+    s.group_begin[0] = 0;
+    for (size_t g = 0; g < ngroups; ++g) {
+        s.group_begin[g + 1] = s.group_begin[g] + s.group_fill[g];
+        s.group_fill[g] = s.group_begin[g];
+    }
+    s.order.resize(T);
+    for (size_t ci = 0; ci < T; ++ci) {
+        const int32_t g = s.cand_group[ci];
+        if (g >= 0) {
+            s.order[s.group_fill[g]++] = static_cast<uint32_t>(ci);
+        }
+    }
+
+    if (ascending_offsets) {
+        auto before = [candidate_locs](uint32_t a, uint32_t b) {
+            const idx_t oa = lo_offset(candidate_locs[a]);
+            const idx_t ob = lo_offset(candidate_locs[b]);
+            return oa < ob || (oa == ob && a < b);
+        };
+        for (size_t g = 0; g < ngroups; ++g) {
+            uint32_t* first = s.order.data() + s.group_begin[g];
+            uint32_t* last = s.order.data() + s.group_begin[g + 1];
+            if (last - first <= 32) {
+                for (uint32_t* i = first + 1; i < last; ++i) {
+                    const uint32_t x = *i;
+                    uint32_t* j = i;
+                    while (j > first && before(x, *(j - 1))) {
+                        *j = *(j - 1);
+                        --j;
+                    }
+                    *j = x;
+                }
+            } else {
+                std::sort(first, last, before);
+            }
+        }
+    }
+
+    s.dis.resize(T);
+    s.ids.resize(T);
+    s.refined.assign(T, 0);
+
+    for (size_t g = 0; g < ngroups; ++g) {
+        const idx_t list_no = s.group_list[g];
+        const size_t list_size = index.invlists->list_size(list_no);
+        size_t p = s.group_begin[g];
+        const size_t end = s.group_begin[g + 1];
+        // A list none of whose candidates lies inside it is never opened, as
+        // in the one-at-a-time loop.
+        while (p < end) {
+            const idx_t offset = lo_offset(candidate_locs[s.order[p]]);
+            if (offset >= 0 && static_cast<size_t>(offset) < list_size) {
+                break;
+            }
+            ++p;
+        }
+        if (p == end) {
+            continue;
+        }
+
+        scanner->set_list(list_no, 0.0f);
+        InvertedLists::ScopedCodes codes(index.invlists, list_no);
+        InvertedLists::ScopedIds ids(index.invlists, list_no);
+        ++counters.groups;
+        ++counters.set_list_calls;
+        ++counters.scoped_acquisitions;
+
+        const uint8_t* list_codes = codes.get();
+        const idx_t* list_ids = ids.get();
+        for (; p < end; ++p) {
+            const uint32_t ci = s.order[p];
+            const idx_t loc = candidate_locs[ci];
+            const idx_t offset = lo_offset(loc);
+            if (offset < 0 || static_cast<size_t>(offset) >= list_size) {
+                continue;
+            }
+            s.dis[ci] = jhq_scanner->refine_distance_from_primary_for_list(
+                static_cast<size_t>(offset),
+                list_codes + static_cast<size_t>(offset) * index.code_size,
+                candidate_primary[ci]);
+            s.ids[ci] = store_pairs ? loc : list_ids[offset];
+            s.refined[ci] = 1;
+            ++counters.candidates;
+        }
+    }
+
+    for (size_t ci = 0; ci < T; ++ci) {
+        if (s.refined[ci]) {
+            push_refined(is_max_heap, k, simi, idxi, s.dis[ci], s.ids[ci]);
+        }
+    }
+
+    ++counters.grouped_queries;
+    scratch_bytes = std::max(scratch_bytes, s.bytes());
+    return true;
+}
+
+// The refinement of the global two-stage search, shared by both entry points:
+// the candidates (the global primary top-T, primary order) are refined from
+// their residual codes and pushed into the query's result heap.
+void refine_global_candidates(const IndexIVFJHQ& index,
+    InvertedListScanner* scanner,
+    const IVFJHQScanner* jhq_scanner,
+    const float* candidate_primary,
+    const idx_t* candidate_locs,
+    size_t candidate_count,
+    size_t nprobe,
+    bool store_pairs,
+    bool is_max_heap,
+    size_t k,
+    float* simi,
+    idx_t* idxi,
+    RefineCounters& counters,
+    size_t& scratch_bytes)
+{
+    int mode = index.refine_grouping;
+    if (mode < 0) {
+        mode = candidate_count >= index.refine_grouping_min_candidates
+            ? IndexIVFJHQ::kRefineGroupingAuto
+            : 0;
+    }
+    if (mode > 0 &&
+        refine_grouped(index, scanner, jhq_scanner, candidate_primary, candidate_locs,
+            candidate_count, nprobe, mode == 2, store_pairs, is_max_heap, k, simi, idxi,
+            counters, scratch_bytes)) {
+        return;
+    }
+    refine_one_at_a_time(index, scanner, jhq_scanner, candidate_primary, candidate_locs,
+        candidate_count, store_pairs, is_max_heap, k, simi, idxi, counters);
+}
+
