+#!/bin/bash
+# Builds the reference library (the commit before the optimisation: compile fixes and the benchmark,
+# refinement as in 1636e19) and the optimised one side by side, with the same compiler and flags
+# (those of the earlier box build: g++-12, Release, AVX2 without AVX-512):
+#   $LGR/build_ref/examples/bench_refine_locality, $LGR/build_opt/examples/bench_refine_locality
+#
+#   bash build_box.sh <reference commit> <optimised commit>
+#
+# Sources: /root/autodl-tmp/JHQ_lgr (a clone of jiabhan/JHQ with this branch fetched) and a worktree
+# of it for the reference; both use the same faiss checkout (5702caf) in jhq/external/faiss.
+set -u
+REFC=$1; OPTC=$2
+LGR=/root/autodl-tmp/lgr
+SRC=/root/autodl-tmp/JHQ_lgr
+SRC_REF=/root/autodl-tmp/JHQ_lgr_ref
+export PATH=/usr/local/bin:/usr/bin:/bin:$PATH
+build_one() {
+  local src=$1 bld=$2 log=$3
+  {
+    echo "=== $(date -u +%FT%TZ) $(git -C $src log --oneline -1) tree $(git -C $src rev-parse HEAD^{tree})"
+    timeout 900 cmake -S $src/jhq -B $bld -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++-12 \
+      -DCMAKE_CXX_FLAGS="-mavx2 -mno-avx512f -mno-avx512vl -mno-avx512bw -mno-avx512dq -include immintrin.h" \
+      -DENABLE_CLANG_TIDY=OFF -DENABLE_CLANG_FORMAT=OFF -DENABLE_CMAKE_FORMAT=OFF -DENABLE_TESTING=OFF > $bld.cmake.log 2>&1
+    echo "cmake_rc=$?"
+    timeout 3600 cmake --build $bld -j 12 --target bench_refine_locality > $bld.build.log 2>&1
+    rc=$?; echo "build_rc=$rc"
+    [ $rc -ne 0 ] && { grep -E "error" $bld.build.log | head -20; echo "=== BUILD_FAILED"; exit 1; }
+    ls -la $bld/examples/bench_refine_locality
+    echo "=== BUILD_DONE $(date -u +%FT%TZ)"
+  } > $log 2>&1
+}
+mkdir -p $LGR
+git -C $SRC checkout -q --detach $OPTC || exit 1
+[ -d $SRC_REF ] || git -C $SRC worktree add -q --detach $SRC_REF $REFC
+git -C $SRC_REF checkout -q --detach $REFC || exit 1
+[ -e $SRC_REF/jhq/external/faiss ] || ln -s $SRC/jhq/external/faiss $SRC_REF/jhq/external/faiss
+build_one $SRC $LGR/build_opt $LGR/build_opt.log &
+build_one $SRC_REF $LGR/build_ref $LGR/build_ref.log &
+wait
+grep -h "^===\|build_rc" $LGR/build_opt.log $LGR/build_ref.log
diff --git a/jhq/benchmarks/refine_locality/run_box.sh b/jhq/benchmarks/refine_locality/run_box.sh
