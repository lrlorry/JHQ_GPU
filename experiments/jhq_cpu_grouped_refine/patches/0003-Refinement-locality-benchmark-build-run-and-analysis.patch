--- /dev/null
+++ b/jhq/benchmarks/refine_locality/run_box.sh
@@ -0,0 +1,54 @@
+#!/bin/bash
+# List-grouped residual refinement: correctness and time on vogue-768, the reference library
+# (3b50db4, the original refinement) against the optimised one (this branch), same flags.
+#
+#   bash run_box.sh <out dir> [smoke]
+#
+# Expects build_box.sh's binaries:  $LGR/build_ref/examples/bench_refine_locality  (reference)
+#                                   $LGR/build_opt/examples/bench_refine_locality  (optimised)
+# 1. one index, built once by the optimised binary (index code is the same in both):
+#    nlist 1024, M 96, levels [8, 4], trained on the first 300000 vectors, all 932328 added
+# 2. per storage (separated, predecoded, packed): the optimised binary with modes 0,1,2
+#    interleaved in-process (7 rounds), then the reference binary on the same grid (3 rounds;
+#    its hashes must equal the optimised binary's for every configuration)
+# 3. inner-product correctness on a 100000-vector subset
+# CPU quota is 25 cores (cgroup cpu.max); batch runs use 16 threads, single-query runs one.
+set -u
+OUT=$1; SMOKE=${2:-}
+LGR=/root/autodl-tmp/lgr
+D=/root/data
+BASE=$D/vogue-768_base.fvecs; QUERY=$D/vogue-768_query.fvecs; GT=$D/vogue-768_groundtruth.ivecs
+REF=$LGR/build_ref/examples/bench_refine_locality
+OPT=$LGR/build_opt/examples/bench_refine_locality
+IDX=$LGR/index/vogue_nl1024_m96
+mkdir -p $OUT $LGR/index
+export OPENBLAS_NUM_THREADS=1 OMP_WAIT_POLICY=PASSIVE
+echo "=== $(date -u +%FT%TZ) refine locality run, smoke=${SMOKE:-no}"
+for b in $REF $OPT; do [ -x $b ] || { echo "missing $b"; exit 1; }; done
+nproc; cat /sys/fs/cgroup/cpu.max; uptime
+
+if [ ! -f $IDX.full.idx ]; then
+  env OMP_NUM_THREADS=24 JHQ_NLIST=1024 JHQ_M=96 JHQ_BR=4 JHQ_NTRAIN=300000 \
+      timeout 7200 $OPT build $BASE $IDX > $OUT/build_index.log 2>&1
+  echo "build_index rc=$? $(tail -1 $OUT/build_index.log)"
+  [ -f $IDX.full.idx ] || { echo "=== DONE index build failed"; exit 1; }
+fi
+ls -la $IDX.*
+
+export JHQ_BENCH_SINGLE_NQ=100
+ROUNDS_OPT=7; ROUNDS_REF=3
+if [ -n "$SMOKE" ]; then
+  export JHQ_BENCH_GRID=10:10,100:20 JHQ_BENCH_NPROBE=32
+  ROUNDS_OPT=2; ROUNDS_REF=2
+fi
+for st in predecoded packed separated; do
+  env JHQ_BENCH_ROUNDS=$ROUNDS_OPT \
+      timeout 7200 $OPT run $st $IDX $BASE $QUERY $GT $OUT/opt_$st.json > $OUT/opt_$st.log 2>&1
+  echo "opt $st rc=$? $(tail -1 $OUT/opt_$st.log)  $(date -u +%T)"
+  env JHQ_BENCH_ROUNDS=$ROUNDS_REF \
+      timeout 7200 $REF run $st $IDX $BASE $QUERY $GT $OUT/ref_$st.json > $OUT/ref_$st.log 2>&1
+  echo "ref $st rc=$? $(tail -1 $OUT/ref_$st.log)  $(date -u +%T)"
+done
+env OMP_NUM_THREADS=16 timeout 3600 $OPT ipcheck $BASE $QUERY $OUT/opt_ip.json > $OUT/opt_ip.log 2>&1
+echo "ipcheck rc=$? $(tail -1 $OUT/opt_ip.log)"
+echo "=== REFINE_LOCALITY_DONE $(date -u +%FT%TZ)"
