From f3d6879dc62c82a5d8f1700d7823614978d7fba7 Mon Sep 17 00:00:00 2001
From: Rui Luo <u8076655@anu.edu.au>
Date: Wed, 14 Oct 2026 05:10:55 +1100
Subject: [PATCH 5/7] Refinement: timers and counters behind JHQ_REFINE_PROFILE

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 jhq/jhqlib/impl/IndexIVFJHQSearch.cpp | 47 +++++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/jhq/jhqlib/impl/IndexIVFJHQSearch.cpp b/jhq/jhqlib/impl/IndexIVFJHQSearch.cpp
index a30154d..45d427d 100644
--- a/jhq/jhqlib/impl/IndexIVFJHQSearch.cpp
+++ b/jhq/jhqlib/impl/IndexIVFJHQSearch.cpp
@@ -18,6 +18,13 @@
 #include <numeric>
 #include <vector>
 
+// JHQ_REFINE_PROFILE=1 times the two stages of the global two-stage search and
+// fills the refinement counters of indexIVFJHQ_stats (bench_refine_locality);
+// 0 compiles the search without them.
+#ifndef JHQ_REFINE_PROFILE
+#define JHQ_REFINE_PROFILE 1
+#endif
+
 namespace faiss {
 
 namespace {
@@ -461,17 +468,24 @@ void IndexIVFJHQ::search_preassigned(idx_t n,
         ? transformed_queries_single_level.data()
         : x;
 
+#if JHQ_REFINE_PROFILE
     size_t st_two_stage = 0, st_candidates = 0, st_groups = 0, st_set_list = 0;
     size_t st_scoped = 0, st_grouped = 0, st_scratch = 0;
     int64_t st_primary_ns = 0, st_refine_ns = 0;
 
 #pragma omp parallel if (n > 1) reduction(+ : total_ndis, st_two_stage, st_candidates, st_groups, \
         st_set_list, st_scoped, st_grouped, st_primary_ns, st_refine_ns) reduction(max : st_scratch)
+#else
+#pragma omp parallel if (n > 1) reduction(+ : total_ndis)
+#endif
     {
         std::unique_ptr<InvertedListScanner> scanner(
             get_InvertedListScanner(store_pairs, nullptr, params));
         auto* jhq_scanner = dynamic_cast<IVFJHQScanner*>(scanner.get());
         RefineCounters counters;
+#if !JHQ_REFINE_PROFILE
+        size_t st_scratch = 0;
+#endif
 
         std::vector<float> candidate_primary;
         std::vector<idx_t> candidate_locs;
@@ -545,7 +559,9 @@ void IndexIVFJHQ::search_preassigned(idx_t n,
                     ndis_query += list_size;
                 }
             } else {
+#if JHQ_REFINE_PROFILE
                 const auto t_primary = RefineClock::now();
+#endif
                 candidate_primary.resize(candidate_keep);
                 candidate_locs.resize(candidate_keep);
 
@@ -617,9 +633,11 @@ void IndexIVFJHQ::search_preassigned(idx_t n,
                         candidate_locs.data());
                 }
 
+#if JHQ_REFINE_PROFILE
                 const auto t_refine = RefineClock::now();
                 st_primary_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(
                     t_refine - t_primary).count();
+#endif
 
                 refine_global_candidates(*this,
                     scanner.get(),
@@ -636,9 +654,11 @@ void IndexIVFJHQ::search_preassigned(idx_t n,
                     counters,
                     st_scratch);
 
+#if JHQ_REFINE_PROFILE
                 st_refine_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(
                     RefineClock::now() - t_refine).count();
                 ++st_two_stage;
+#endif
             }
 
             if (is_max_heap) {
@@ -650,11 +670,16 @@ void IndexIVFJHQ::search_preassigned(idx_t n,
             total_ndis += ndis_query;
         }
 
+#if JHQ_REFINE_PROFILE
         st_candidates += counters.candidates;
         st_groups += counters.groups;
         st_set_list += counters.set_list_calls;
         st_scoped += counters.scoped_acquisitions;
         st_grouped += counters.grouped_queries;
+#else
+        (void)counters;
+        (void)st_scratch;
+#endif
     }
 
     if (ivf_stats) {
@@ -663,6 +688,7 @@ void IndexIVFJHQ::search_preassigned(idx_t n,
 
     indexIVFJHQ_stats.nq += n;
     indexIVFJHQ_stats.ndis += total_ndis;
+#if JHQ_REFINE_PROFILE
     indexIVFJHQ_stats.n_two_stage += st_two_stage;
     indexIVFJHQ_stats.refine_candidates += st_candidates;
     indexIVFJHQ_stats.refine_groups += st_groups;
@@ -673,6 +699,7 @@ void IndexIVFJHQ::search_preassigned(idx_t n,
     indexIVFJHQ_stats.refine_stage_time += st_refine_ns * 1e-6;
     indexIVFJHQ_stats.refine_scratch_bytes =
         std::max(indexIVFJHQ_stats.refine_scratch_bytes, st_scratch);
+#endif
 }
 
 void IndexIVFJHQ::search_preassigned_with_rotated_queries(
@@ -706,17 +733,24 @@ void IndexIVFJHQ::search_preassigned_with_rotated_queries(
 
     size_t total_ndis = 0;
 
+#if JHQ_REFINE_PROFILE
     size_t st_two_stage = 0, st_candidates = 0, st_groups = 0, st_set_list = 0;
     size_t st_scoped = 0, st_grouped = 0, st_scratch = 0;
     int64_t st_primary_ns = 0, st_refine_ns = 0;
 
 #pragma omp parallel if (n > 1) reduction(+ : total_ndis, st_two_stage, st_candidates, st_groups, \
         st_set_list, st_scoped, st_grouped, st_primary_ns, st_refine_ns) reduction(max : st_scratch)
+#else
+#pragma omp parallel if (n > 1) reduction(+ : total_ndis)
+#endif
     {
         std::unique_ptr<InvertedListScanner> scanner(
             get_InvertedListScanner(store_pairs, nullptr, params));
         auto* jhq_scanner = dynamic_cast<IVFJHQScanner*>(scanner.get());
         RefineCounters counters;
+#if !JHQ_REFINE_PROFILE
+        size_t st_scratch = 0;
+#endif
 
         std::vector<float> candidate_primary;
         std::vector<idx_t> candidate_locs;
@@ -790,7 +824,9 @@ void IndexIVFJHQ::search_preassigned_with_rotated_queries(
                     ndis_query += list_size;
                 }
             } else {
+#if JHQ_REFINE_PROFILE
                 const auto t_primary = RefineClock::now();
+#endif
                 candidate_primary.resize(candidate_keep);
                 candidate_locs.resize(candidate_keep);
 
@@ -862,9 +898,11 @@ void IndexIVFJHQ::search_preassigned_with_rotated_queries(
                         candidate_locs.data());
                 }
 
+#if JHQ_REFINE_PROFILE
                 const auto t_refine = RefineClock::now();
                 st_primary_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(
                     t_refine - t_primary).count();
+#endif
 
                 refine_global_candidates(*this,
                     scanner.get(),
@@ -881,9 +919,11 @@ void IndexIVFJHQ::search_preassigned_with_rotated_queries(
                     counters,
                     st_scratch);
 
+#if JHQ_REFINE_PROFILE
                 st_refine_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(
                     RefineClock::now() - t_refine).count();
                 ++st_two_stage;
+#endif
             }
 
             if (is_max_heap) {
@@ -895,11 +935,16 @@ void IndexIVFJHQ::search_preassigned_with_rotated_queries(
             total_ndis += ndis_query;
         }
 
+#if JHQ_REFINE_PROFILE
         st_candidates += counters.candidates;
         st_groups += counters.groups;
         st_set_list += counters.set_list_calls;
         st_scoped += counters.scoped_acquisitions;
         st_grouped += counters.grouped_queries;
+#else
+        (void)counters;
+        (void)st_scratch;
+#endif
     }
 
     if (ivf_stats) {
@@ -908,6 +953,7 @@ void IndexIVFJHQ::search_preassigned_with_rotated_queries(
 
     indexIVFJHQ_stats.nq += n;
     indexIVFJHQ_stats.ndis += total_ndis;
+#if JHQ_REFINE_PROFILE
     indexIVFJHQ_stats.n_two_stage += st_two_stage;
     indexIVFJHQ_stats.refine_candidates += st_candidates;
     indexIVFJHQ_stats.refine_groups += st_groups;
@@ -918,6 +964,7 @@ void IndexIVFJHQ::search_preassigned_with_rotated_queries(
     indexIVFJHQ_stats.refine_stage_time += st_refine_ns * 1e-6;
     indexIVFJHQ_stats.refine_scratch_bytes =
         std::max(indexIVFJHQ_stats.refine_scratch_bytes, st_scratch);
+#endif
 }
 
 void IndexIVFJHQ::range_search_preassigned(idx_t nx,
